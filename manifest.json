{
  "manifest_version": 3,
  "name": "Inline Local Translator",
  "version": "1.0.0",
  "description": "Translate English webpage text into Chinese below the original text using a local Ollama model.",
  "key": "",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://*.services.ai.azure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Inline Local Translator",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "translate-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "翻译当前页面"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
